# Copier ce fichier en .env (jamais versionné) puis renseigner une clé.
# Fournisseur pour la rédaction des messages : gemini, huggingface ou aucun.
RECOUVREMENT_IA_FOURNISSEUR=gemini

# Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELE=gemini-3.5-flash

# Hugging Face (modèle Meta Llama, licence à accepter sur la page du modèle) : https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODELE=meta-llama/Llama-3.1-8B-Instruct
